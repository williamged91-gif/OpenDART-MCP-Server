# --- Required for a secure public deployment ---------------------------------
# Long random string. Anyone connecting must include ?token=THIS_VALUE in the
# connector URL; otherwise the route returns 401. Generate with:
#   openssl rand -hex 32
# or any password manager.
MCP_ACCESS_TOKEN=

# --- OpenDART API key (recommended) ------------------------------------------
# Used as a fallback when the connector URL doesn't carry ?opendart_key=...
# If you set this AND share the URL with others, they will use YOUR daily
# quota. Only set it for your own personal connector.
OPENDART_API_KEY=

# --- Optional ----------------------------------------------------------------
# Set to "1" to re-enable mcp-handler verbose logs. Off by default because
# verbose mode logs full request URLs (which contain the OpenDART API key)
# into Vercel's log stream.
# MCP_VERBOSE_LOGS=0
